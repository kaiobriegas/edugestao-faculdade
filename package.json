{
  "name": "plataforma-modulos-educacionais",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts prisma.config.ts",
    "env:init": "node scripts/init-env.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:local:init": "node scripts/local-postgres.mjs init",
    "db:local:start": "node scripts/local-postgres.mjs start",
    "db:local:stop": "node scripts/local-postgres.mjs stop",
    "test:unit": "vitest run --project unit",
    "test:integration": "node scripts/test-integration.mjs",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --project unit --coverage",
    "check": "npm run db:generate && npm run db:validate && npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "test:e2e:install": "node scripts/install-browser.mjs",
    "test:mail": "node scripts/smoke-mail.mjs",
    "mail:local:start": "powershell -NoProfile -File scripts/mailpit-local.ps1 start",
    "mail:local:stop": "powershell -NoProfile -File scripts/mailpit-local.ps1 stop",
    "bootstrap:root": "tsx scripts/bootstrap-root.ts",
    "test:all": "npm run check && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.2",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.9",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
