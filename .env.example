# Não inserir segredos reais neste arquivo. Execute npm run env:init.
DATABASE_URL=
TEST_DATABASE_URL=
POSTGRES_DB=educacional
POSTGRES_USER=educacional
POSTGRES_PASSWORD=
POSTGRES_PORT=54329
APP_URL=http://localhost:3000
AUTH_SECRET=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=Plataforma Educacional <nao-responda@educacional.local>
STORAGE_PRIVATE_DIR=./storage/private
MAX_UPLOAD_BYTES=10485760
TZ=America/Sao_Paulo
# Opcional para PostgreSQL nativo no Windows, sem serviço global:
POSTGRES_BIN=
# Root é criado por npm run bootstrap:root, sem senha fixa.
